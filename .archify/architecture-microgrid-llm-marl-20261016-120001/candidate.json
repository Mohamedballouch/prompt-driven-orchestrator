  "cards": [
    {
      "dot": "violet",
      "title": "Slow layer (every 15 h)",
      "items": [
        "The LLM picks one of five operating modes, re-weights the shared reward and tightens soft constraints",
        "It never actuates a device: it only emits a JSON directive",
        "If a call or parse fails, the last validated directive stays in force"
      ]
    },
    {
      "dot": "emerald",
      "title": "Fast layer (every hour)",
      "items": [
        "Six learned controllers: two machines, wind, solar, battery, generator",
        "The backbone is chosen with train_native.py --backbone sac|ppo|mappo|ddqn",
        "Observations end with the 4 current directive weights"
      ]
    },
    {
      "dot": "rose",
      "title": "Authority guards",
      "items": [
        "The validator clamps and normalizes weights and enforces a 0.1 stability floor",
        "force_generator_off is ignored while SOC < 0.30 and renewables are below demand"
      ]
    },
    {
      "dot": "amber",
      "title": "Evaluation",
      "items": [
        "Non-LLM controls: rule-based, static weights, scheduled ToU, random directive",
        "The README states no LLM advantage has been established yet"
      ]
    }
  ]
